{
  "name": "my-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Sahsha storefront — logic from @pradip1995 packages, design from @pradip1995/theme-sahsha",
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "kit:sync-docs": "node node_modules/@pradip1995/create-storefront/lib/generate-agents-md.js",
    "postinstall": "node -e \"const fs=require('fs');const p='scripts/patch-kit-fetch-cache.js';if(!fs.existsSync(p)){console.warn('[postinstall] skip: '+p+' not found');process.exit(0)}require('child_process').execFileSync(process.execPath,[p],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@medusajs/js-sdk": "latest",
    "@medusajs/ui": "latest",
    "@pradip1995/commerce-auth": "4.0.2",
    "@pradip1995/commerce-core": "^4.0.9",
    "@pradip1995/create-storefront": "^3.1.7",
    "@pradip1995/storefront-controllers": "^3.1.7",
    "@pradip1995/storefront-registry": "^3.0.0",
    "@pradip1995/theme-sahsha": "^3.1.3",
    "@radix-ui/react-accordion": "^1.2.1",
    "@react-oauth/google": "^0.12.2",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "color": "^5.0.3",
    "country-state-city": "^3.2.1",
    "firebase": "^12.8.0",
    "framer-motion": "^12.42.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "next": "15.3.8",
    "pg": "^8.11.3",
    "qs": "^6.12.1",
    "react": "19.0.3",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.3",
    "react-phone-input-2": "^2.15.1",
    "react-razorpay": "^3.0.1",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0"
  },
  "devDependencies": {
    "@medusajs/types": "latest",
    "@medusajs/ui-preset": "latest",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.8",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.7.2"
  }
}
